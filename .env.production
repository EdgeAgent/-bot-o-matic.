# Production Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================
# Backend Configuration
# ============================================

NODE_ENV=production
PORT=3001

# Security - GENERATE NEW VALUES FOR PRODUCTION!
JWT_SECRET=CHANGE_THIS_TO_32_CHAR_SECRET
ENCRYPTION_KEY=CHANGE_THIS_TO_32_CHARACTERS!

# Database
DATABASE_PATH=./data/botomatic.db

# ============================================
# LLM Configuration
# ============================================

# Default provider when user doesn't provide their own API key
DEFAULT_LLM_PROVIDER=openai

# Your LLM API Keys (at least one required)
DEFAULT_OPENAI_API_KEY=sk-your-openai-api-key-here
# DEFAULT_GEMINI_API_KEY=your-gemini-api-key-here
# DEFAULT_ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ============================================
# Stripe Payment Configuration
# ============================================

# Use test keys for staging, live keys for production
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Pricing in cents
PRICE_BASIC=500
PRICE_PREMIUM=1000

# ============================================
# Frontend Configuration
# ============================================

# Backend API URL
NEXT_PUBLIC_API_URL=https://your-backend-url.com

# Demo mode (true = simulate payments, false = real Stripe)
NEXT_PUBLIC_DEMO_MODE=false

# Your frontend URL
NEXT_PUBLIC_APP_URL=https://your-frontend-url.com

# Stripe publishable key (must match backend)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# ============================================
# Docker Compose Variables (if using Docker)
# ============================================

COMPOSE_PROJECT_NAME=bot-o-matic
