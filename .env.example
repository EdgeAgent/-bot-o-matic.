# Backend Configuration
PORT=3001
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
ENCRYPTION_KEY=your-32-character-encryption-key!
DATABASE_PATH=./data/botomatic.db

# Default LLM (when user doesn't provide their own)
DEFAULT_LLM_PROVIDER=openai
DEFAULT_OPENAI_API_KEY=sk-your-openai-key-here

# Optional: Add more default providers
# DEFAULT_GEMINI_API_KEY=your-gemini-key
# DEFAULT_ANTHROPIC_API_KEY=your-anthropic-key

# Stripe Payment Integration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Pricing Tiers (in cents)
PRICE_BASIC=500
PRICE_PREMIUM=1000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
